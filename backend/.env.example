# Local development only. Do not commit real credentials.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:5432/hameed_hliwi_local
DATABASE_POOL_MAX=10
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
SESSION_TOKEN_PEPPER=replace_with_a_different_long_random_secret_at_least_32_characters
REFRESH_SESSION_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_MAX=120
SEED_ADMIN_PASSWORD=development_only_change_me

# Production only: use once for the initial administrator, then remove all three values.
PRODUCTION_BOOTSTRAP_USERNAME=initial_admin
PRODUCTION_BOOTSTRAP_FULL_NAME=Initial Administrator
PRODUCTION_BOOTSTRAP_PASSWORD=replace_with_a_strong_one_time_password
